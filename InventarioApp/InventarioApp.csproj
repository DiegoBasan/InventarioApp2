<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- Portabilidad: index.html y una config por defecto viajan embebidos en el .exe y se
       extraen a %LocalAppData%\InventarioApp la primera vez que corre en una PC (ver AppPaths.cs).
       Así, copiar solo el .exe a otra máquina es suficiente; no hace falta llevar la carpeta completa. -->
  <ItemGroup>
    <None Remove="index.html" />
    <EmbeddedResource Include="index.html">
      <LogicalName>InventarioApp.WebAssets.index.html</LogicalName>
    </EmbeddedResource>

    <None Remove="appsettings.json" />
    <EmbeddedResource Include="appsettings.json">
      <LogicalName>InventarioApp.WebAssets.appsettings.default.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- logo.png/logo.svg son opcionales: si alguno no existe todavía en el proyecto, se omite
       sin romper el build (útil sobre todo para logo.svg, que aún no se ha agregado). -->
  <ItemGroup Condition="Exists('logo.png')">
    <None Remove="logo.png" />
    <EmbeddedResource Include="logo.png">
      <LogicalName>InventarioApp.WebAssets.logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="Exists('logo.svg')">
    <None Remove="logo.svg" />
    <EmbeddedResource Include="logo.svg">
      <LogicalName>InventarioApp.WebAssets.logo.svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>